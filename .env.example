# Copy to .env (never commit .env)
DATABASE_URL=postgresql://countersign:countersign@localhost:5432/countersign
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Cloudflare Pages + Render: the Pages Function proxies /api, so keep COOKIE_SAMESITE=lax and
# leave CORS_ORIGINS empty. See docs/DEPLOYMENT.md.
# CORS_ORIGINS=

# Render PR previews (IS_PULL_REQUEST=true is set by Render) refuse to start without this
# PREVIEW_DATABASE_URL=

# LLM: Gemini on a billing-enabled project with a spend cap, Groq as fallback.
GEMINI_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.5-flash
GROQ_API_KEY=
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# or LLM_FALLBACK_PROVIDER=groq with GROQ_API_KEY and LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# auto | fastembed | hash        auto | presidio | regex
EMBEDDINGS=auto
PII_ENGINE=auto
SANDBOX_POOL_SIZE=2
