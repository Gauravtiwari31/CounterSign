# Copy to .env (never commit .env)
DATABASE_URL=postgresql://countersign:countersign@localhost:5432/countersign
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Cross-origin deployment (Cloudflare Pages frontend → Render backend)
# Set CORS_ORIGINS to your Cloudflare Pages URL and COOKIE_SAMESITE=none + COOKIE_SECURE=true
# CORS_ORIGINS=https://countersign-5s3.pages.dev
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# LLM: Gemini on a billing-enabled project with a spend cap, Groq as fallback.
GEMINI_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.5-flash
GROQ_API_KEY=
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# or LLM_FALLBACK_PROVIDER=groq with GROQ_API_KEY and LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# auto | fastembed | hash        auto | presidio | regex
EMBEDDINGS=auto
PII_ENGINE=auto
SANDBOX_POOL_SIZE=2
